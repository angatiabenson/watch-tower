{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/watchtower-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Monitoring": {
    "Cpu": {
      "PollIntervalSeconds": 5,
      "ThresholdPercent": 99.0,
      "SustainedSeconds": 300,
      "TopProcessCount": 3
    },
    "Ram": {
      "PollIntervalSeconds": 5,
      "ThresholdPercent": 90.0,
      "SustainedSeconds": 300,
      "TopProcessCount": 5
    },
    "Disk": {
      "PollIntervalSeconds": 60,
      "WarningThresholdPercent": 70.0,
      "CriticalThresholdPercent": 85.0,
      "QueueLengthWarningThreshold": 2.0
    },
    "Services": {
      "PollIntervalSeconds": 30,
      "MaxRestartAttempts": 3,
      "RestartDelaySeconds": 10,
      "WatchedServices": []
    },
    "Network": {
      "PollIntervalSeconds": 30,
      "OutputQueueWarningThreshold": 0.0
    }
  },
  "Heartbeat": {
    "Url": "https://hc-ping.com/your-uuid-here",
    "IntervalSeconds": 1800
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "WatchTower",
    "ToAddresses": []
  },
  "Reporting": {
    "ReportIntervalSeconds": 7200,
    "EmergencyCooldownSeconds": 300
  }
}
