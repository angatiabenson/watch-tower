<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Reference implementation of the WatchTower portal agent API v1 (spec/portal-agent-api.v1.openapi.yaml).
    Cross-platform on purpose: it overrides the repository-wide net10.0-windows target so it runs on
    Linux and macOS too. It is a sample, never part of the agent's package (build/package.ps1 only
    publishes src/WatchTower).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WatchTower.Samples.MinimalPortal</RootNamespace>
    <AssemblyName>MinimalPortal</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
